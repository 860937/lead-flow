# ========================================================
# Lead Flow - Environment Variables Template
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# Security Secrets
JWT_SECRET=leadflow_jwt_secret_change_this_in_production_min_32_chars!

# Admin Credentials (Used to seed default admin on initial boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=LeadFlow@Coimbatore2026!

# Business Contact & Lead Alert Destination
NOTIFICATION_EMAIL=suganth46801@gmail.com

# SMTP Email Configuration (Nodemailer - Gmail App Password)
# Note: In Gmail, go to Google Account -> Security -> 2-Step Verification -> App Passwords
# Generate a 16-character App Password for "Mail" and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=suganth46801@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="Lead Flow Alerts" <suganth46801@gmail.com>

# Optional: Cloudflare Turnstile or Google reCAPTCHA v3 Secret Key
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA
